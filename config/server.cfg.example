// Counter-Strike 1.6 dedicated server example configuration.
// Copy this file to cstrike/server.cfg on the game-server host.
// Set the RCON password on the host itself. Never commit it to Git.

hostname "CS 1.6 Public Test Server"
 sv_lan 0

// Capacity target. Validate actual performance before opening 32 slots.
maxplayers 32

// Basic server behavior.
mp_timelimit 25
mp_winlimit 0
mp_maxrounds 0
mp_freezetime 3
mp_roundtime 2
mp_c4timer 35
mp_startmoney 800
mp_buytime 0.25
mp_autoteambalance 1
mp_limitteams 1
mp_friendlyfire 0
mp_flashlight 1
mp_footsteps 1
mp_forcecamera 0
mp_forcechasecam 0

// Logging and network behavior.
log on
mp_logdetail 0
sv_maxrate 25000
sv_minrate 5000
sv_maxupdaterate 100
sv_minupdaterate 20
sv_region 3

// RCON is intentionally not configured here.
// Configure a long, unique rcon_password directly on the server host.
