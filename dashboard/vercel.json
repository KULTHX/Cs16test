{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/watchdog.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    },
    "api/status.js": {
      "maxDuration": 10
    },
    "api/control.js": {
      "maxDuration": 15
    }
  },
  "schedules": {
    "cs16-watchdog": {
      "schedule": "*/10 * * * *",
      "jitter": 1,
      "function": "api/watchdog",
      "timezone": "UTC"
    }
  }
}
