[Unit]
Description=Counter-Strike 1.6 dedicated server (ReHLDS)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cs16
Group=cs16
WorkingDirectory=/opt/cs16
Environment=HOME=%h
Environment=CS16_SERVER_DIR=/opt/cs16
Environment=CS16_STEAMCMD_DIR=/opt/steamcmd
EnvironmentFile=-/etc/default/cs16-rehlds
ExecStart=/usr/local/bin/cs16-rehlds-start
Restart=always
RestartSec=10
StartLimitIntervalSec=0
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=40
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
